PORT=3000
NODE_ENV=development
MONGO_URI=
# at least 32 chars each and different from each other: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# exactly 64 hex chars (encrypts 2FA secrets in the database): openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
CLIENT_ORIGIN=http://localhost:5173

# Optional limits, in paise (defaults shown)
# MAX_TRANSFER_PAISE=100000000
# MAX_DEPOSIT_PAISE=1000000000
# DAILY_TRANSFER_LIMIT_PAISE=500000000
